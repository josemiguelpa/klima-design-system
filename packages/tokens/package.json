{
  "name": "@klima-ds/tokens",
  "version": "0.0.0",
  "description": "DTCG token sources and validation for Klima Design System",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/tokens",
    "manifest.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@klima-ds/eslint-config": "workspace:*",
    "@klima-ds/typescript-config": "workspace:*",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
