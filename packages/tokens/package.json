{
  "name": "@klima-ds/tokens",
  "version": "0.0.0",
  "description": "Design tokens for Klima Design System: DTCG sources, CSS custom properties and TypeScript values",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/tokens",
    "manifest.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./tooling": {
      "types": "./dist/tooling.d.ts",
      "default": "./dist/tooling.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:generated": "node scripts/check-generated.mjs",
    "prepack": "node scripts/build.mjs && node scripts/check-generated.mjs"
  },
  "devDependencies": {
    "@klima-ds/eslint-config": "workspace:*",
    "@klima-ds/typescript-config": "workspace:*",
    "@types/node": "^26.6.2",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
